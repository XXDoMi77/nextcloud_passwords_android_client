# ---------------------------------------------------------------------------
# Secrets - never commit. Signing material lives outside the repository entirely;
# the build finds it through the NPAC_KEYSTORE_PROPERTIES environment variable.
# ---------------------------------------------------------------------------
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.der
*.key
*_rsa
*_dsa
*_ed25519
*_ecdsa
keystore.properties
signing.properties
*secret*.properties
*credential*.properties
google-services.json
play-service-account*.json
*.env
.env.*

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
.gradle/
build/
/captures
.externalNativeBuild
.cxx
.kotlin/
*.apk
*.aab
*.aar
mapping.txt
/app/release/
/app/debug/
/release/

# ---------------------------------------------------------------------------
# Local machine configuration
# ---------------------------------------------------------------------------
local.properties
*.iml
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# IDE — share only project-level conventions, ignore machine-local state
# ---------------------------------------------------------------------------
.idea/*
!.idea/codeStyles/
!.idea/ktfmt.xml
!.idea/vcs.xml
!.idea/runConfigurations/

# Screenshot captures land beside the release scripts, outside the repo. Anchored to the root:
# unanchored, "screenshots/" matches a directory of that name at any depth, which silently
# swallowed docs/screenshots and left the README pointing at files that were never committed.
/screenshots/

# Scratch files at the repo root
test.kt
