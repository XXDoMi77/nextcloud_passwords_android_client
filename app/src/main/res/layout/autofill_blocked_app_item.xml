<?xml version="1.0" encoding="utf-8"?><!--
    One app in the blocked-app picker.

    The name and package sit in their own vertical block centred against the icon. They used to be pinned
    to the top of a fixed 64dp row, which left a long name riding high and clipped to one line; the row
    now grows to fit and the name may wrap onto a second line.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_horizontal"
    android:paddingVertical="@dimen/spacing_group_vertical">

    <ImageView
        android:id="@+id/blocked_app_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_group_horizontal"
        android:layout_weight="1"
        android:gravity="center|start"
        android:orientation="vertical">

        <TextView
            android:id="@+id/blocked_app_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/blocked_app_package"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textSize="12sp" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/blocked_app_checkbox"
        android:layout_width="48dp"
        android:layout_height="48dp" />
</LinearLayout>
