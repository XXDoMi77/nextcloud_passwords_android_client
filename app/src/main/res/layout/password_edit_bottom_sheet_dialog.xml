<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/passwordEditPopup"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TableLayout
        android:id="@+id/tableLayoutButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:stretchColumns="*"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TableRow
            android:id="@+id/tableRowButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <ImageButton
                android:id="@+id/imageButtonStar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:scaleType="fitCenter"
                android:contentDescription="@string/toggle_favorite"
                app:srcCompat="@drawable/icon_star_outline_24"
                app:tint="?attr/colorSurfaceContainerHigh" />

            <ImageButton
                android:id="@+id/imageButtonShield"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:scaleType="fitCenter"
                android:contentDescription="@string/security_status"
                app:srcCompat="@drawable/icon_shield_24"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/imageButtonPencil"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:scaleType="fitCenter"
                android:contentDescription="@string/edit_password"
                app:srcCompat="@drawable/icon_edit_24"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/imageButtonTrashcan"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:scaleType="fitCenter"
                android:contentDescription="@string/delete_password"
                app:srcCompat="@drawable/icon_delete_24"
                app:tint="@color/red" />

            <ImageButton
                android:id="@+id/imageButtonClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:scaleType="fitCenter"
                android:contentDescription="@string/close"
                app:srcCompat="@drawable/icon_close_24"
                app:tint="?attr/colorOnSurface" />
        </TableRow>

        <TableRow
            android:id="@+id/tableRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/imageButtonCloseRow"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:scaleType="fitCenter"
                android:contentDescription="@string/cancel"
                app:srcCompat="@drawable/icon_close_24"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/textViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_span="3"
                android:gravity="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Title" />

            <ImageButton
                android:id="@+id/imageButtonSwoosh"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:scaleType="fitCenter"
                android:contentDescription="@string/save_password"
                app:srcCompat="@drawable/icon_check_24"
                app:tint="?attr/colorOnSurface" />
        </TableRow>
    </TableLayout>

    <!--
        Bounded rather than wrap_content, and constrained to the bottom: without that the content
        simply grew past the sheet and the last section - the share list - was clipped instead of
        scrolling into view. clipToPadding keeps the padding scrollable, so the final row can clear
        the navigation bar the sheet now draws behind.
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tableLayoutButtons">


        <LinearLayout
            android:id="@+id/myLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>