<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.folders.FoldersFragment">

    <HorizontalScrollView
        android:id="@+id/path_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FF000000"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/breadcrumb_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp" />
    </HorizontalScrollView>

    <!-- The one and only sync indicator: pulling, and the automatic foreground sync, both show this
         same bar. It sweeps rather than showing determinate progress, because one stage dominates a
         sync and a percentage would sit still and then jump. -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/folders_sync_indicator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/sync_indicator_color"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/path_scroll"
        app:trackColor="@android:color/transparent"
        app:trackCornerRadius="2dp" />

    <com.dominikdomotor.nextcloudpasswords.ui.PullToRefreshLayout
        android:id="@+id/folders_pull_refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/path_scroll">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/folders_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="160dp"
            android:scrollbarStyle="insideOverlay"
            android:theme="@style/FastScrollBar" />
    </com.dominikdomotor.nextcloudpasswords.ui.PullToRefreshLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/create_password"
        app:backgroundTint="@color/floating_action_button_background"
        app:layout_constraintBottom_toTopOf="@id/add_folder"
        app:layout_constraintEnd_toEndOf="parent"
        app:rippleColor="@color/floating_action_button_ripple"
        app:srcCompat="@drawable/icon_add_24"
        app:tint="@color/floating_action_button_icon" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_folder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/create_folder"
        app:backgroundTint="@color/floating_action_button_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:rippleColor="@color/floating_action_button_ripple"
        app:srcCompat="@drawable/icon_create_new_folder_24"
        app:tint="@color/floating_action_button_icon" />
</androidx.constraintlayout.widget.ConstraintLayout>