<?xml version="1.0" encoding="utf-8"?>
<resources>

    <color name="transparent">#00000000</color>

    <color name="red">#FFFF0000</color>

    <!-- Password security status. Deliberately vivid in both themes. -->
    <color name="password_status_secure">#00FF00</color>
    <color name="password_status_warning">#FFFF00</color>
    <color name="password_status_insecure">#FF0000</color>
    <color name="favorite_star">#ECA700</color>

    <!--
        The autofill dropdown's own text colours.

        These have to be literals. The suggestion rows are a RemoteViews tree, inflated inside the app
        that asked for the fill - a browser, a banking app - where our theme does not exist, so a
        ?attr/ reference would resolve against a stranger's theme or not at all. Kept as their own pair
        rather than reusing the palette slots, so nobody later "tidies" them into theme attributes.
    -->
    <color name="autofill_presentation_text">#FF000000</color>
    <color name="autofill_presentation_shaded">#99000000</color>

    <!--
        The system splash background.

        Read by the system before the process starts, so it can never follow a generated palette. Sits
        near the default seed's surface tone to keep the handover to the first frame quiet.
    -->
    <color name="splash_background">#FFF7F9FF</color>

    <!--
        The discard button.

        Literal, not a palette slot. "This one loses your work" is a signal, and a signal that
        re-tints with the seed stops being one: a blue seed produces a blue-leaning error
        container, which is the exact moment the button needs to still read as red.
    -->
    <color name="destructive_container">#FFFFDAD6</color>
    <color name="on_destructive_container">#FF410002</color>

    <color name="chrome_autofill_step_frame">#14000000</color>
</resources>