<?xml version="1.0" encoding="utf-8"?>
<!--
    Material 3's emphasized easing: leaves quickly, settles slowly, and never overshoots.

    The same curve the pull-to-refresh header settles on, so movement across the app reads as one hand.
-->
<pathInterpolator xmlns:android="http://schemas.android.com/apk/res/android"
    android:controlX1="0.05"
    android:controlY1="0.7"
    android:controlX2="0.1"
    android:controlY2="1" />
