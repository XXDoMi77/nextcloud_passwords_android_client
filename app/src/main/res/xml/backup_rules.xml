<?xml version="1.0" encoding="utf-8"?><!--
    The pre-Android-12 half of the same decision as data_extraction_rules.xml: nothing is backed up.

    Kept even though android:allowBackup is false, because the manifest attribute is the switch and
    this is the statement of intent - if backup were ever turned on, the default would be to copy the
    encrypted store to a device whose Keystore cannot decrypt it.
-->
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
