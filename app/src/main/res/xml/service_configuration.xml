<?xml version="1.0" encoding="utf-8"?>
<!--
    Autofill service configuration.

    Browsers render pages in their own process and do not expose web form fields as ordinary views, so
    an autofill service only sees them when Android's *compatibility mode* is enabled for that
    browser. `maxLongVersionCode` is the highest browser version compatibility mode applies to.

    This list started as a copy of the AOSP sample, whose Chrome entries were capped at 711900039 —
    a 2018-era Chrome 71. Installed Chrome is version code 797706404 (v152), roughly 86 million above
    that cap, so compatibility mode silently never activated and web logins either offered nothing or
    depended on Chrome's own third-party autofill setting. Hence "sometimes it works, sometimes it
    does not".

    The cap is now uniformly high, matching what the entries copied from AOSP already used for the
    non-Chrome browsers.
-->
<autofill-service xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:supportsInlineSuggestions="true"
    tools:ignore="UnusedAttribute">

    <!-- Chromium-based, alphabetical -->
    <compatibility-package
        android:name="com.android.chrome"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.brave.browser"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.chrome.beta"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.chrome.canary"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.chrome.dev"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.duckduckgo.mobile.android"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.kiwibrowser.browser"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.microsoft.emmx"
        android:maxLongVersionCode="10000000000" />
    <!-- Xiaomi's stock browser, shipped on this project's own test device -->
    <compatibility-package
        android:name="com.mi.globalbrowser"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.opera.browser"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.opera.browser.beta"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.opera.mini.native"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.opera.mini.native.beta"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.sec.android.app.sbrowser"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.sec.android.app.sbrowser.beta"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.vivaldi.browser"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="org.chromium.chrome"
        android:maxLongVersionCode="10000000000" />

    <!-- Gecko-based -->
    <compatibility-package
        android:name="org.mozilla.fennec_aurora"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="org.mozilla.firefox"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="org.mozilla.firefox_beta"
        android:maxLongVersionCode="10000000000" />
</autofill-service>
