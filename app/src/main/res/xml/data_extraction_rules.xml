<?xml version="1.0" encoding="utf-8"?><!--
    Nothing is backed up or transferred, and that is deliberate rather than unconfigured.

    The offline password store is encrypted with a key held in the Android Keystore, and a Keystore
    key never leaves the device it was generated on. A copy restored onto a new phone or pulled
    through a device-to-device transfer would therefore be undecryptable - the user would get an app
    that looks signed in, holds a file it cannot read, and has to be logged out and set up again.
    Excluding everything means it asks for the account once instead, which is the honest outcome.

    android:allowBackup is false as well, so cloud backup is off regardless; this file governs what
    Android 12+ would otherwise still take during a direct transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
