<?xml version="1.0" encoding="utf-8"?>
<!--
    The key placeholder for an autofill suggestion row.

    A separate drawable from icon_vpn_key_24 because RemoteViews are inflated by the requesting app
    without AppCompat, so `app:tint` on the ImageView is ignored and `android:tint` there cannot be
    cleared below API 31 (RemoteViews#setColorStateList). Carrying the tint in the drawable keeps the
    placeholder theme-aware while leaving the ImageView untinted, so a favicon bitmap set on it shows
    in its own colours on every supported version.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:tint="@color/normal_text_color"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12.65,10C11.83,7.67 9.61,6 7,6c-3.31,0 -6,2.69 -6,6s2.69,6 6,6c2.61,0 4.83,-1.67 5.65,-4H17v4h4v-4h2v-4H12.65zM7,14c-1.1,0 -2,-0.9 -2,-2s0.9,-2 2,-2 2,0.9 2,2 -0.9,2 -2,2z" />
</vector>
