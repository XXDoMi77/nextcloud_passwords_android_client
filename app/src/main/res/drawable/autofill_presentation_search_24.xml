<!--
    The "search all passwords" row of an autofill suggestion list.

    Path data from icon_baseline_manage_search_24: a magnifier over a list, which is what that row
    does, rather than the plain magnifier that suggests searching the page.

    A separate drawable from that one for the same reason autofill_presentation_key_24 exists: the
    tree is inflated in the requesting app's process, so the tint has to be a plain colour resource
    from this package rather than a theme attribute - and it cannot stay white, which is what the
    source icon carries, because the popup it lands on is light.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:autoMirrored="true"
    android:tint="@color/autofill_presentation_text"
    android:viewportWidth="24"
    android:viewportHeight="24">
