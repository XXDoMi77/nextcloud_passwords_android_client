<?xml version="1.0" encoding="utf-8"?>
<!--
    The last row, mirroring list_group_top.

    A ripple rather than a bare shape: setting a row's background replaces whatever it had, so a
    plain shape here left the rows with no press or hover feedback at all. The mask keeps the
    ripple inside the row's own corners.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSecondaryContainer" />
            <corners
            android:bottomLeftRadius="@dimen/radius_group"
            android:bottomRightRadius="@dimen/radius_group"
            android:topLeftRadius="@dimen/radius_item"
            android:topRightRadius="@dimen/radius_item" />
        </shape>
    </item>

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners
            android:bottomLeftRadius="@dimen/radius_group"
            android:bottomRightRadius="@dimen/radius_group"
            android:topLeftRadius="@dimen/radius_item"
            android:topRightRadius="@dimen/radius_item" />
        </shape>
    </item>
</ripple>
