<?xml version="1.0" encoding="utf-8"?>
<!--
    A row in the middle of a group: barely rounded, so the block reads as one object.

    A ripple rather than a bare shape: setting a row's background replaces whatever it had, so a
    plain shape here left the rows with no press or hover feedback at all. The mask keeps the
    ripple inside the row's own corners.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSecondaryContainer" />
            <corners android:radius="@dimen/radius_item" />
        </shape>
    </item>

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/radius_item" />
        </shape>
    </item>
</ripple>
