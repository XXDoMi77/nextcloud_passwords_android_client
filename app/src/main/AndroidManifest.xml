<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The login-completed notification is silently dropped on API 33+ without this. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_FILL_AND_PROTECT" />
    <!--
        The autofill blocked-apps picker only needs to list launchable apps. QUERY_ALL_PACKAGES is a
        Play-restricted permission requiring a declaration form; this <queries> element gives the
        same visibility without it.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/launcher_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/launcher_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App.Starting"
        tools:targetApi="33">
        <service
            android:name=".services.LoginPollingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name="com.dominikdomotor.nextcloudpasswords.autofill.MyAutofillService"
            android:exported="true"
            android:label="Nextcloud Passwords"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE"
            android:process=":autofill_process">
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/service_configuration" />
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
        </service>

        <activity
            android:name=".activities.OverviewActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.EnterServerURLActivity"
            android:exported="false"
            android:theme="@style/Theme.NextcloudPasswords">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NextcloudPasswords">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />

            <intent-filter>
                <data android:scheme="nc" />
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".autofill.AutofillPickerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.NextcloudPasswords" />
    </application>

</manifest>